# Copy this file to .env. Never commit .env.
# Web config is public in the built client. The service account is not.

# Firebase console → Project settings → Your apps → SDK setup.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=devchronicle-hugo
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# true only when a production build should talk to the local emulators.
FIREBASE_USE_EMULATORS=false

# Path to a service-account JSON. Used by scripts/import-content.mjs --project.
# The emulator import does not read this.
GOOGLE_APPLICATION_CREDENTIALS=

NG_APP_SITE_NAME=DevChronicle
NG_APP_AUTHOR_NAME=Hugo Colmenares

# Canonical origin for canonical links, Open Graph URLs, robots.txt, and sitemap.xml.
# Change it when a custom domain replaces the web.app host (also set the GitHub repository
# variable NG_APP_SITE_URL used by the build workflow).
NG_APP_SITE_URL=https://devchronicle-hugo.web.app
