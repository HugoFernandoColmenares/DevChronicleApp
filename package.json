{
  "name": "dev-chronicle",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/write-environment.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:import": "node --test tests/markdown-entry.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devchronicle \"npx vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-devchronicle",
    "import:emulator": "node scripts/import-content.mjs --emulator --project demo-devchronicle",
    "seed:admin": "node scripts/seed-emulator-admin.mjs --emulator --project demo-devchronicle",
    "lint": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@firebase/app": "0.16.5",
    "@firebase/app-compat": "0.5.21"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "dompurify": "^3.4.15",
    "firebase": "^12.19.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/dompurify": "^3.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
